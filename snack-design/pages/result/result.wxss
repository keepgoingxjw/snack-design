.allergen-alert{background:#fcf1cd;border:2rpx solid #eadba7;border-radius:24rpx;padding:22rpx;font-size:24rpx;margin:28rpx 0;color:#695333}
.tabs{white-space:nowrap;margin:24rpx 0 30rpx;width:100%}.tab{display:inline-block;border:2rpx solid #d9cce7;border-radius:40rpx;padding:14rpx 22rpx;margin-right:12rpx;font-size:24rpx}.active{background:#725294;color:#fff;border-color:#725294}.group{margin:28rpx 0 40rpx;border:2rpx solid #e3daec;border-radius:26rpx;overflow:hidden}.group-head{background:#e8ddf3;padding:23rpx;display:flex;justify-content:space-between;font-weight:600}.column{display:flex;background:#f2ecf9;padding:17rpx 20rpx;font-size:22rpx;color:#706282}.column text:first-child{width:160rpx;flex-shrink:0}.ingredient{display:flex;background:#fffefc;border-top:2rpx solid #e3daec;padding:26rpx 20rpx;gap:20rpx}.name{width:140rpx;flex-shrink:0;border-right:2rpx solid #eee6f4;padding-right:12rpx;font-size:28rpx;font-weight:600}.name .tag{font-size:21rpx;padding:4rpx 8rpx;margin-top:15rpx;white-space:normal}.explanation{flex:1;min-width:0;font-size:25rpx;line-height:1.85}.field{display:block;color:#526e62;font-size:24rpx;font-weight:600;margin-bottom:6rpx}.risk{border-top:2rpx dashed #e6dce8;padding-top:15rpx;margin-top:17rpx}.risk .field{color:#94523a}.explanation .link{font-size:22rpx;margin-top:16rpx;text-decoration:underline}
