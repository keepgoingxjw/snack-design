page{background:#fbfaff;color:#493c62;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;font-size:28rpx;line-height:1.65}view,text,button,textarea{box-sizing:border-box}button::after{border:0}button{font-size:28rpx;line-height:1.5} .page{max-width:900rpx;margin:0 auto;padding:32rpx 40rpx 64rpx;padding-bottom:calc(64rpx + env(safe-area-inset-bottom))}.muted{color:#706282;font-size:24rpx}.eyebrow{font-size:24rpx;color:#706282}.title{font-size:52rpx;line-height:1.45;font-weight:700;margin:24rpx 0 16rpx}.subtitle{font-size:34rpx;font-weight:700}.primary,.secondary{width:100%;border-radius:30rpx;padding:27rpx 20rpx;margin:22rpx 0 0;font-weight:600;white-space:normal}.primary{background:#725294;color:#fff;box-shadow:0 6rpx 0 #573b76}.secondary{background:#fffefb;border:2rpx solid #ded1e9;color:#604976}.card{background:#fffefb;border:2rpx solid #e4d9ed;border-radius:30rpx;padding:28rpx;margin-top:20rpx}.section{display:flex;justify-content:space-between;align-items:center;margin:42rpx 0 18rpx;gap:16rpx}.section .subtitle{font-size:31rpx}.note{background:#f0eaf7;color:#706282;border-radius:20rpx;padding:22rpx;font-size:24rpx;margin:24rpx 0;line-height:1.8}.logo{width:110rpx;height:110rpx;border-radius:28rpx}.row{display:flex;align-items:center;gap:22rpx}.grow{flex:1;min-width:0}.tag{display:inline-block;background:#f6edc9;color:#76613d;border-radius:12rpx;padding:5rpx 14rpx;font-size:22rpx}.empty{text-align:center;padding:90rpx 16rpx}.link{color:#725294;font-size:24rpx;word-break:break-all}.danger{color:#9d5149}.small{font-size:23rpx;color:#706282}.heading{font-size:42rpx;font-weight:700;margin:18rpx 0}.wrap{overflow-wrap:break-word;word-break:break-all}
