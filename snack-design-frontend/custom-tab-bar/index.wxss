:host{display:block}.tabbar{position:fixed;z-index:1000;left:0;right:0;bottom:0;display:flex;align-items:center;height:108rpx;box-sizing:content-box;padding-bottom:env(safe-area-inset-bottom);background:#fbfaff;border-top:1rpx solid #eee7f4}.tab-item{flex:1;min-width:0;height:108rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#81738f}.tab-item.selected{color:#725294}.tab-icon{display:block;width:54rpx;height:54rpx;margin-bottom:4rpx}.tab-label{font-size:23rpx;line-height:1.5}
