.page{padding-bottom:calc(172rpx + env(safe-area-inset-bottom))}
.page .home-action{display:block;width:100%;max-width:none;box-sizing:border-box;margin:22rpx 0 0;transition:transform .1s ease,background-color .1s ease,box-shadow .1s ease}
.page .home-primary-pressed{transform:translateY(4rpx);background:#634581;box-shadow:0 2rpx 0 #573b76}
.page .home-secondary-pressed{transform:translateY(2rpx);background:#f0e8f7;border-color:#c9b7dc;box-shadow:inset 0 2rpx 4rpx #72529414}
.hero{height:390rpx;background:#fae6ae;border-radius:110rpx 85rpx 70rpx 65rpx;position:relative;margin:50rpx 0 34rpx;display:flex;align-items:center;justify-content:center}.paper{width:460rpx;padding:34rpx 28rpx 24rpx;background:#fffdf6;border:2rpx solid #b6a088;border-radius:18rpx;transform:rotate(-7deg);box-shadow:12rpx 12rpx 0 #a98c5225;color:#554b3d}.paper-title{font-size:27rpx;font-weight:600}.paper-lines{font-size:23rpx;margin:15rpx 0}.barcode{display:block;width:100%;height:48rpx}.hero-logo{position:absolute;right:5rpx;bottom:8rpx;width:170rpx;height:170rpx;border-radius:50%}.bubble{position:absolute;right:18rpx;top:-28rpx;z-index:3;background:#e8d9f1;color:#65497e;border:6rpx solid #fbfaff;border-radius:50rpx 56rpx 44rpx 50rpx;padding:18rpx 20rpx;font-weight:700;font-size:26rpx;line-height:1.6;transform:rotate(9deg);text-align:left;white-space:nowrap}.scan-link{text-align:center;padding:22rpx;color:#725294;font-size:25rpx}.sample-section{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:46rpx 0 22rpx}.sample-heading{font-size:32rpx;font-weight:700;line-height:1.5}.sample-section-hint{font-size:22rpx;color:#706282;white-space:nowrap}.sample-card{display:flex;align-items:center;gap:22rpx;width:100%;padding:26rpx 22rpx;background:#fffefa;border:2rpx solid #e1d7e9;border-radius:34rpx;color:#493c62;text-align:left}.sample-cookie{position:relative;flex-shrink:0;width:88rpx;height:88rpx;border:4rpx solid #c5a77e;border-radius:50%;background:#ead3a4;box-shadow:inset 0 0 0 8rpx #f4e3c0;transform:rotate(-10deg)}.cookie-dot{position:absolute;width:8rpx;height:8rpx;background:#a5825f;border-radius:50%}.dot-one{top:20rpx;left:22rpx}.dot-two{top:30rpx;left:46rpx}.dot-three{top:52rpx;left:24rpx}.dot-four{top:54rpx;left:54rpx}.sample-copy{flex:1;min-width:0}.sample-title{font-size:28rpx;font-weight:700;line-height:1.5}.sample-description{font-size:22rpx;color:#706282;line-height:1.6;margin-top:8rpx}.sample-disclaimer{font-size:20rpx;color:#806c82;line-height:1.6;margin-top:6rpx}.sample-action{flex-shrink:0;font-size:24rpx;color:#725294;white-space:nowrap}.lessons{display:flex;gap:20rpx}.lesson{flex:1;background:#eee6f6;border-radius:28rpx;padding:25rpx 20rpx;font-weight:600}.lesson>text:first-child{font-size:40rpx}.lesson .small{display:block;font-weight:400;margin-top:14rpx}.yellow{background:#f8efce}.steps{padding:24rpx 16rpx;background:#f1eaf7;border-radius:20rpx;font-size:23rpx;text-align:center}
