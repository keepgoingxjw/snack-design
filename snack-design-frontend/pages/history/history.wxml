<view class="page"><text class="eyebrow">每次看懂，都有迹可循</text><view class="heading">我的配料记录</view><view wx:if="{{loading}}" class="note">正在加载服务端记录…</view><view wx:if="{{error}}" class="note danger">{{error}}<button class="secondary" bindtap="onShow">重新读取</button></view><view wx:if="{{!records.length && !error && !loading}}" class="empty"><image src="/assets/history-empty.png" class="logo" mode="aspectFit"/><view class="subtitle" style="margin-top:22rpx">还没有配料记录</view><view class="small">从一张包装，开始认识配料。</view><button class="primary" bindtap="home">去看看配料</button></view><view wx:for="{{records}}" wx:key="id" class="card"><view data-id="{{item.id}}" bindtap="open"><view class="row"><text class="tag">{{item.kind}}</text><text class="small">{{item.date}}</text></view><view class="record-text">{{item.raw}}</view><text class="link">查看解析 ›</text></view><view data-id="{{item.id}}" bindtap="remove" class="delete">删除记录</view></view><button wx:if="{{records.length}}" class="secondary" bindtap="clear">清空当前用户记录</button></view>
