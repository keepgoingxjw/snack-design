.demo-intro{padding:24rpx;background:#fcf3d8;border:2rpx solid #eadba7;border-radius:26rpx;margin:24rpx 0}.demo-badge{font-size:24rpx;color:#806143;font-weight:700;margin-bottom:10rpx}.demo-selector{display:flex;gap:12rpx;flex-wrap:wrap;margin:22rpx 0}.demo-choice{font-size:24rpx;color:#725294;background:#fffefa;border:2rpx solid #d9cce7;border-radius:30rpx;padding:10rpx 18rpx}.demo-choice.selected{color:#fff;background:#725294;border-color:#725294}.demo-raw-label{font-size:25rpx;font-weight:700;margin-top:14rpx}.demo-raw{font-size:26rpx;line-height:1.9;color:#604e40;margin-top:10rpx;word-break:break-word}
.recommendation{background:#f0eaf7;border:2rpx solid #ded1ed;border-radius:26rpx;padding:26rpx;margin:26rpx 0;line-height:1.8}.recommendation.avoid_for_group,.recommendation.consult_professional{background:#fcf0e9;border-color:#e9cbbc}.recommendation.limit_frequency{background:#fcf3d8;border-color:#eadba7}.advice-kicker{font-size:22rpx;color:#706282}.advice-title{font-size:35rpx;font-weight:700;margin:10rpx 0;color:#604976}.advice-audience,.advice-reason{font-size:25rpx;margin-top:12rpx}.advice-conditions{font-size:22rpx;color:#706282;border-top:2rpx dashed #d9cce7;padding-top:16rpx;margin-top:18rpx}.advice-source{margin-top:12rpx}.ingredient-advice{border-top:2rpx dashed #e6dce8;padding-top:15rpx;margin-top:17rpx}
.summary-point{margin-top:10rpx}.field+.summary-point{margin-top:0}.summary-lead{font-weight:700}.summary-bullet{color:#806c95}
.result-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.result-head .heading{font-size:38rpx}.trust{font-size:24rpx;color:#725294;border-bottom:2rpx solid #d9cce7;padding:22rpx 0;margin:20rpx 0}.allergen-alert{background:#f4e8d4;color:#695333;border:2rpx solid #ead8b8;border-radius:24rpx;padding:22rpx;font-size:24rpx;line-height:1.8}.strong{font-weight:700}.hint{font-size:24rpx;line-height:1.8;color:#706282}.tabs{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.tab{border:2rpx solid #d9cce7;border-radius:40rpx;padding:12rpx 20rpx;background:#fffaf0;color:#665276;font-size:24rpx}.tab.active{background:#725294;color:#fff;border-color:#725294}.group{margin:28rpx 0 36rpx;border:2rpx solid #e3daec;border-radius:26rpx;overflow:hidden}.group-head{background:#e8ddf3;padding:23rpx;display:flex;align-items:center;justify-content:space-between;font-weight:700}.column{display:flex;background:#f2ecf9;padding:17rpx 20rpx;font-size:22rpx;color:#706282}.column text:first-child{width:160rpx;flex-shrink:0}.ingredient{display:flex;background:#fffefc;border-top:2rpx solid #e3daec;padding:26rpx 20rpx;gap:20rpx}.name{width:140rpx;flex-shrink:0;border-right:2rpx solid #eee6f4;padding-right:12rpx;word-break:break-all}.ingredient-name{font-size:28rpx;font-weight:700}.name .tag{font-size:21rpx;padding:4rpx 8rpx;margin-top:15rpx;white-space:normal}.explanation{flex:1;min-width:0;font-size:25rpx;line-height:1.85;word-break:break-word}.field{display:block;color:#526e62;font-size:24rpx;font-weight:700;margin-bottom:6rpx}.risk,.dosage{border-top:2rpx dashed #e6dce8;padding-top:15rpx;margin-top:17rpx}.risk .field{color:#94523a}.dosage .field{color:#725294}.reference{margin-top:18rpx}.reference .link{font-size:22rpx;text-decoration:underline}.quote{font-size:22rpx;line-height:1.8;color:#706282;margin:10rpx 0;border-left:4rpx solid #e3d8ed;padding-left:12rpx;white-space:pre-wrap}.verification{font-size:21rpx;line-height:1.7;color:#806c82;margin-top:16rpx}.report-meta{font-size:22rpx;color:#706282;line-height:1.8;word-break:break-word}.progress{padding:24rpx;background:#f6edca;border-radius:22rpx;font-size:26rpx}.research-error{padding:24rpx;border:2rpx solid #dfb6ac;background:#fcf0e9;border-radius:22rpx;font-size:26rpx;color:#94523a;margin:24rpx 0;word-break:break-word}.history-link{font-size:24rpx;color:#725294;padding:22rpx 0}.history-item{padding:18rpx;border-bottom:2rpx solid #e6dce8;font-size:24rpx}.page .primary,.page .secondary{display:block;width:100%;max-width:none;box-sizing:border-box}
