.lesson-page{padding:46rpx 46rpx calc(70rpx + env(safe-area-inset-bottom));font-size:30rpx;line-height:1.7}
.lesson-hero{background:#ece3f5;padding:48rpx 44rpx;border-radius:50rpx;position:relative;min-height:490rpx;margin-bottom:50rpx;overflow:hidden}
.lesson-hero.yellow{background:#f8efcc}.lesson-eyebrow{color:#776487;font-size:24rpx}
.lesson-title{font-size:56rpx;line-height:1.45;white-space:pre-line;position:relative;z-index:1;margin:26rpx 0 20rpx;font-weight:700;letter-spacing:-1rpx}
.lesson-lead{font-size:26rpx;max-width:calc(100% - 156rpx);color:#665675;position:relative;z-index:1}
.lesson-character{position:absolute;right:20rpx;bottom:30rpx;width:176rpx;height:200rpx}
.lesson-summary{font-size:42rpx;font-weight:600;white-space:pre-line;line-height:1.6;margin:36rpx 0 48rpx}
.lesson-flow{display:flex;margin:40rpx 0 52rpx;gap:10rpx}.lesson-flow>view{flex:1;font-size:24rpx;text-align:center;border-bottom:6rpx solid #bba2d3;padding-bottom:20rpx}
.lesson-part{padding:46rpx 0;border-top:2rpx solid #dfd4e8}.part-title{font-size:38rpx;margin:0 0 24rpx;font-weight:700}.part-copy{color:#61566d;margin:16rpx 0 28rpx}
.lesson-example{font-size:26rpx;line-height:1.8;background:#f5efdb;border-radius:24rpx;padding:24rpx 28rpx;color:#77613d}
.lesson-refs{margin:50rpx 0 16rpx;font-size:24rpx;color:#776487}.refs-toggle{padding:16rpx 0;min-height:88rpx}.reference-link{color:#725294;padding:14rpx 0;overflow-wrap:break-word}
.lesson-endnote{font-size:24rpx;color:#81748c;margin:16rpx 0 28rpx}.lesson-page .lesson-next,.lesson-page .lesson-home{display:block;width:100%;max-width:none;box-sizing:border-box;margin:22rpx 0 0;transition:transform .1s ease,background-color .1s ease,box-shadow .1s ease}
.lesson-page .lesson-next-pressed{transform:translateY(4rpx);background:#634581;box-shadow:0 2rpx 0 #573b76}
.lesson-page .lesson-home-pressed{transform:translateY(2rpx);background:#f0e8f7;border-color:#c9b7dc;box-shadow:inset 0 2rpx 4rpx #72529414}
