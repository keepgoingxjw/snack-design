  try {
    if (window.__mintlifyInitialSidebarScrollDone) return;

    var path = (window.location.pathname || '/').split('#')[0].split('?')[0];
    if (path.endsWith('/index')) path = path.slice(0, -6);
    else if (path === 'index') path = '';

    var candidates = [];
    if (path) candidates.push(path);
    if (path.startsWith('/')) candidates.push(path.slice(1));
    else candidates.push('/' + path);

    var item = null;
    for (var i = 0; i < candidates.length && !item; i++) {
      var matches = document.querySelectorAll('[id="' + candidates[i].replace(/"/g, '\\"') + '"]');
      for (var j = 0; j < matches.length; j++) {
        if (matches[j].closest('#sidebar, #sidebar-content') && matches[j].getClientRects().length) {
          item = matches[j];
          break;
        }
      }
    }
    if (!item) return;
    window.__mintlifyInitialSidebarScrollDone = true;

    var parent = item.closest('[data-component-part="scroll-area-viewport"]');
    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var row = item.querySelector(':scope > button') || item;
    var parentRect = parent.getBoundingClientRect();
    var itemRect = row.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://openrouter.ai/#organization","name":"OpenRouter | Documentation","url":"https://openrouter.ai","logo":{"@type":"ImageObject","url":"https://mintcdn.com/openrouter-d02e98a0/ksNSeB_K7gD-BUDh/assets/logo-v2-light.svg?fit=max&auto=format&n=ksNSeB_K7gD-BUDh&q=85&s=690e45873843519efe02bcbe45795dac"}},{"@type":"WebSite","@id":"https://openrouter.ai/docs#website","name":"OpenRouter | Documentation","url":"https://openrouter.ai/docs","publisher":{"@id":"https://openrouter.ai/#organization"}},{"@type":"WebPage","@id":"https://openrouter.ai/docs/guides/routing/provider-selection#webpage","url":"https://openrouter.ai/docs/guides/routing/provider-selection","name":"Provider Routing","description":"Route requests to the best provider","dateModified":"2026-10-16T16:43:16.600Z","isPartOf":{"@id":"https://openrouter.ai/docs#website"},"breadcrumb":{"@id":"https://openrouter.ai/docs/guides/routing/provider-selection#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://openrouter.ai/docs/guides/routing/provider-selection#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Models & Routing","item":"https://openrouter.ai/docs/guides/routing/model-fallbacks"},{"@type":"ListItem","position":2,"name":"Provider Routing","item":"https://openrouter.ai/docs/guides/routing/provider-selection"}]},{"@type":["Article","TechArticle"],"@id":"https://openrouter.ai/docs/guides/routing/provider-selection#article","headline":"Provider Routing","name":"Provider Routing","description":"Route requests to the best provider","url":"https://openrouter.ai/docs/guides/routing/provider-selection","mainEntityOfPage":{"@id":"https://openrouter.ai/docs/guides/routing/provider-selection#webpage"},"image":"https://openrouter.ai/dynamic-og?pathname=features/provider-routing&ti