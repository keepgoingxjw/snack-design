id:`provider-specific-headers`,children:`Provider-Specific Headers`}),`\n`,_jsx(_components.p,{children:`Some providers support beta features that can be enabled through special headers. OpenRouter allows you to pass through certain provider-specific beta headers when making requests.`}),`\n`,_jsx(Heading,{level:`3`,id:`anthropic-beta-features`,children:`Anthropic Beta Features`}),`\n`,_jsxs(_components.p,{children:[`When using Anthropic models (Claude), you can request specific beta features by including the `,_jsx(_components.code,{children:`x-anthropic-beta`}),` header in your request. OpenRouter will pass through supported beta features to Anthropic.`]}),`\n`,_jsx(Heading,{level:`4`,id:`supported-beta-features`,children:`Supported Beta Features`}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Feature`}),_jsx(_components.th,{children:`Header Value`}),_jsx(_components.th,{children:`Description`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Interleaved Thinking`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`interleaved-thinking-2025-05-14`})}),_jsx(_components.td,{children:`Allows Claude’s thinking/reasoning to be interleaved with regular output, rather than appearing as a single block`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Structured Outputs`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`structured-outputs-2025-11-13`})}),_jsx(_components.td,{children:`Enables the strict tool use feature for supported Claude models, validating tool parameters against your schema to ensure correctly-typed arguments`})]})]})]}),`\n`,_jsxs(Note,{children:[_jsx(_components.p,{children:`OpenRouter manages some Anthropic features automatically:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Prompt caching and extended context`