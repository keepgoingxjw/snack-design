/* ── Code font: Geist Mono ── */
@import url('https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&display=swap');

/*
 * Inverse semantic pair mirrors packages/frontend/components/ui/theme.css.
 * Mintlify is a separate app, so its generated tooltip DOM uses the same
 * light Ink/Cloud and dark Cloud/Ink values through RGB channel variables.
 */
:root {
  --inverse: 3 8 10;
  --inverse-foreground: 252 252 254;
  --tooltip-background: var(--inverse);
  --tooltip-foreground: var(--inverse-foreground);
}

code,
pre,
pre code,
.code-block code,
[class*="code"] code {
  font-family: 'Geist Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
}

/* ── Text selection: accent tint per DESIGN.md ── */
::selection {
  background: rgb(118 36 244 / 0.25);
}

.dark ::selection,
html.dark ::selection {
  background: rgb(200 255 0 / 0.25);
  color: inherit;
}

/* ── Dark-mode accent swap: Volt (#C8FF00 = rgb(200 255 0)) per DESIGN.md ──
 * Mintlify + Tailwind use space-separated RGB: rgb(var(--primary-light) / alpha).
 * Override accent in dark mode from Grape to Volt. */
.dark,
[data-theme="dark"],
html.dark {
  --primary: 200 255 0;
  --primary-light: 200 255 0;
  --primary-dark: 200 255 0;
  --light-primary: 200 255 0;
  --primary-foreground: 3 8 10;
  --inverse: 252 252 254;
  --inverse-foreground: 3 8 10;

  /* ── Dark-mode border: Cloud at 14% per DESIGN.md ── */
  --default-border-color: rgb(252 252 254 / 0.14);
}

/* ── Border radius: bauhaus 4/6/8px scale ── */
#navbar {
  border-radius: 0;
}

/* Sidebar active item */
#sidebar a[aria-current="page"],
nav[aria-label="Pages"] a[aria-current="page"] {
  border-radius: 8px;
}

/* Cards and code blocks */
[data-component-part="code-block-root"] {
  border-radius: 8px;
}

/* ── Link styling per DESIGN.md ──
 * underline at 40% opacity of current color, full on hover, offset 2px */
a:not([class]) {
  text-decoration-thickness: 1px;
  text-underline-offset: 2px;
  text-decoration-color: rgb(0 0 0 / 0.4);
}

a:not([class]):hover {
  text-decoration-color: currentColor;
}

.dark a:not([class]),
html.dark a:not([class]) {
  text-decoration-color: rgb(255 255 255 / 0.4);
}

.dark a:not([class]):hover,
html.dark a:not([class]):hover {
  text-decoration-color: currentColor;
}

/* ── Sidebar badges: outline style ── */
.nav-tag-pill-text {
  background: transparent !important;
  color: rgb(0 0 0 / 0.5) !important;
  border: 1px solid rgb(0 0 0 / 0.2) !important;
}

.dark .nav-tag-pill-text,
html.dark .nav-tag-pill-text {
  background: transparent !important;
  color: rgb(252 252 254 / 0.5) !important;
  border: 1px solid rgb(252 252 254 / 0.2) !important;
}

/* Match the home navbar logo height (h-6 / 1.5rem). */
.nav-logo {
  height: 1.5rem;
}

/* ── Sidebar expand chevrons: raise dark-mode contrast ──
 * Collapsible group toggles render a caret whose default dark tone
 * (gray-600 on Ink) is nearly invisible, so it isn't clear which items
 * have subsections. Derive the caret from Cloud via the DESIGN.md opacity
 * scale: muted-foreground (Cloud `a0`) at rest, full Cloud (foreground) on
 * hover — no custom hex outside the brand palette. */
.dark nav[aria-label="Pages"] button[aria-expanded] svg.transition-transform,
html.dark nav[aria-label="Pages"] button[aria-expanded] svg.transition-transform {
  color: rgb(252 252 254 / 0.627);
}

.dark nav[aria-label="Pages"] button[aria-expanded]:hover svg.transition-transform,
html.dark nav[aria-label="Pages"] button[aria-expanded]:hover svg.transition-transform {
  color: rgb(252 252 254);
}

/* ── Sidebar expand chevrons: enlarge for legibility ──
 * The default caret (w-2 ≈ 8px) is easy to miss; bump its footprint so it
 * reads clearly as an expandable affordance. */
nav[aria-label="Pages"] button[aria-expanded] svg.transition-transform {
  width: 0.625rem;
  height: 0.625rem;
}

/* ── Tooltips: inverse surface pairing ──
 * Mintlify has a foreground variable for tooltips but no matching background
 * variable, so both values are mirrored here from the inverse pair. Its
 * tooltip popup renders through Base UI (role="tooltip" on a data-side popup
 * filled with bg-primary-dark, which is Volt in dark mode); the Radix
 * selectors cover the previous implementation. */
[role="tooltip"][data-side],
[data-radix-popper-content-wrapper]
  > div[data-state="delayed-open"],
[data-radix-popper-content-wrapper]
  > div[data-state="instant-open"] {
  background-color: rgb(var(--tooltip-background)) !important;
  color: rgb(var(--tooltip-foreground)) !important;
}

/* ── Callout + code block alignment ──
 * A code block that is the only child of a callout body carries Mintlify's default
 * prose margins (mt-5 mb-8), which push the snippet down so it no longer lines
 * up with the top-aligned callout icon. Drop those margins so the snippet's
 * top edge aligns with the icon. */
.callout [data-component-part="callout-content"] > .code-block:first-child {
  margin-top: 0;
}

.callout [data-component-part="callout-content"] > .code-block:last-child {
  margin-bottom: 0;
}

/* ── Floating code-block buttons: opaque background ──
 * Mintlify only backs the floating buttons (report / copy / ask) with
 * gray-100/gray-800 when the code block has no fade overlay
 * (group-[:not(:has([data-fade-overlay]))]). Collapsible/expandable blocks
 * always carry a fade overlay, so the buttons stay transparent and the code
 * text bleeds through behind them. Apply the same background unconditionally
 * so the buttons are legible on every code block. */
[data-floating-buttons] button {
  background-color: rgb(241 239 245);
}

.dark [data-floating-buttons] button,
html.dark [data-floating-buttons] button {
  background-color: rgb(40 38 44);
}

/* ── Changelog: Update tags as outline pills (matches sidebar badges) ── */
[data-component-part="update-tag"] {
  border: 1px solid rgb(0 0 0 / 0.2);
  border-radius: 9999px;
  padding: 0.125rem 0.625rem;
  font-size: 0.75rem;
  line-height: 1.25rem;
  color: rgb(0 0 0 / 0.6);
}

.dark [data-component-part="update-tag"],
html.dark [data-component-part="update-tag"] {
  border-color: rgb(252 252 254 / 0.2);
  color: rgb(252 252 254 / 0.6);
}

/* ── Navbar CTA: drop the chevron, pair label and background per theme ──
 * Mintlify renders the primary CTA with a trailing chevron, a text-white
 * label, and a bg-primary-dark fill in both themes (primary-dark maps to
 * docs.json colors.dark = Volt). Per DESIGN.md the pairings are white on
 * Grape in light mode and Ink on Volt in dark mode, which is exactly what
 * --primary already resolves to (Grape from docs.json, Volt via the
 * dark-mode swap above). */
#topbar-cta-button svg {
  display: none;
}

/* Mintlify pads the CTA pl-3/pr-2 to hug the chevron; even it out. */
#topbar-cta-button a {
  padding-right: 0.75rem;
}

#topbar-cta-button .bg-primary-dark {
  background-color: rgb(var(--primary));
}

.dark #topbar-cta-button .text-white,
html.dark #topbar-cta-button .text-white {
  color: rgb(3 8 10);
}

/* ── Changelog: selected filter pill readability ──
 * Mintlify renders the active filter as bg-primary + text-white/90. In dark
 * mode our primary is Volt (#C8FF00), so switch the text to Ink per DESIGN.md. */
.dark #changelog-filters-content button.bg-primary,
html.dark #changelog-filters-content button.bg-primary {
  color: rgb(3 8 10 / 0.9) !important;
}

/* ── Changelog: separate inline status badges from bullet text ── */
.changelog-status-badge {
  margin-left: 0.5rem;
}

.changelog-status-badge[data-color="gray"] {
  border: 1px solid rgb(3 8 10 / 0.3) !important;
}

.dark .changelog-status-badge[data-color="gray"],
html.dark .changelog-status-badge[data-color="gray"] {
  border-color: rgb(252 252 254 / 0.4) !important;
}

/* ── Mermaid: center diagrams in the content column ── */
.mermaid > svg {
  margin-inline: auto;
}

/* ── Compact support matrices ──
 * Mintlify gives every table cell a 150px minimum width, which forces a
 * six-column check/dash table to scroll horizontally in the content column.
 * Cells in a support matrix hold an icon or a short field name, so let them
 * shrink to their content. */
.support-matrix table {
  font-size: 0.8125rem;
}

.support-matrix td,
.support-matrix th {
  min-width: 0;
  padding-right: 0.5rem;
  white-space: nowrap;
}

.support-matrix th code {
  padding-left: 0.25rem;
  padding-right: 0.25rem;
  font-size: 0.6875rem;
}

/* ── Provider routing figures ──
 * Inline SVG illustrations from snippets/exports/ProviderRoutingFigures.jsx.
 * Part colors match the provider dashboard's FortunaBCostBar (chart-1, chart-3,
 * chart-12, negative, chart-4) and its competitive zone (positive); chart
 * colors are the same hex in both themes, so only neutrals change with it. */
.pr-fig,
.pr-mini {
  --pr-ink: #03080a;
  --pr-muted: rgb(3 8 10 / 0.69);
  --pr-rule: rgb(3 8 10 / 0.12);
  --pr-surface: #ffffff;
  --pr-positive-text: #007544;
  --pr-negative-text: #bf0024;
}

.dark .pr-fig,
.dark .pr-mini {
  --pr-ink: #fcfcfe;
  --pr-muted: rgb(252 252 254 / 0.627);
  --pr-rule: rgb(252 252 254 / 0.14);
  --pr-surface: #080d0f;
  --pr-positive-text: #34dfaa;
  --pr-negative-text: #ff2d55;
}

.pr-fig {
  margin: 1.5rem 0;
  padding: 1rem;
  overflow-x: auto;
  container-type: inline-size;
  border: 1px solid var(--pr-rule);
  border-radius: 8px;
  background: var(--pr-surface);
}

.pr-fig svg {
  display: block;
  width: 100%;
  height: auto;
}

.pr-mini {
  margin: 1rem 0 1.25rem;
}

.pr-mini svg {
  display: block;
  max-width: 100%;
  height: auto;
  margin-inline: auto;
}

.pr-fig svg text,
.pr-mini svg text {
  font-family: inherit;
  font-size: 12px;
  fill: var(--pr-muted);
}

.pr-sw {
  display: inline-block;
  flex: none;
  width: 12px;
  height: 12px;
  border-radius: 2px;
}

.pr-bg-price { background: #0088fe; }
.pr-bg-ttft { background: #ffbb28; }
.pr-bg-speed { background: #7b68ee; }
.pr-bg-rel { background: #ff2d55; }
.pr-bg-429 { background: #ff8042; }
.pr-bg-received { background: var(--pr-ink); }
/* Learned capacity is a limit, not a cost part, so its heading swatch is neutral. */
.pr-bg-capacity { background: rgb(var(--gray-400)); }

.pr-fill-ttft { fill: #ffbb28; }
.pr-fill-speed { fill: #7b68ee; }
.pr-fill-rel { fill: #ff2d55; }
.pr-fill-429 { fill: #ff8042; }

/* Charts */
.pr-fig .lbl { font-size: 13px; fill: var(--pr-ink); }
.pr-fig .num { fill: var(--pr-muted); font-variant-numeric: tabular-nums; }
.pr-fig .strong { fill: var(--pr-ink); font-weight: 600; }
.pr-fig .halo { paint-order: stroke; stroke: var(--pr-surface); stroke-width: 4px; stroke-linejoin: round; }
.pr-fig .axis { stroke: var(--pr-rule); stroke-width: 1; }
.pr-fig .zone { fill: rgb(0 191 111 / 0.12); }
.pr-fig .zone-lbl { font-weight: 600; fill: var(--pr-positive-text); }
.pr-fig .zone-lbl.muted { fill: var(--pr-muted); }
.pr-fig .edge { stroke: #00bf6f; stroke-width: 1.5; stroke-dasharray: 4 3; }
.pr-fig .edge-curve { fill: none; stroke: #00bf6f; stroke-width: 2; stroke-dasharray: 5 3; }
.pr-fig .curve { fill: none; stroke: var(--pr-ink); stroke-width: 2.5; }
.pr-fig .curve-fill { fill: var(--pr-ink); opacity: 0.04; }
.pr-fig .dot { fill: var(--pr-muted); fill-opacity: 0.8; stroke: var(--pr-surface); stroke-width: 1.5; }
.pr-fig .dot-in { fill: #00bf6f; stroke: var(--pr-surface); stroke-width: 1.5; }
.pr-fig .got { fill: none; stroke: var(--pr-ink); stroke-width: 2; }
.pr-fig .got-fill { fill: var(--pr-ink); opacity: 0.06; }
.pr-fig .cap { fill: none; stroke: #da70d6; stroke-width: 2.5; }
.pr-fig .real { fill: none; stroke: var(--pr-muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
.pr-fig .rate { fill: #ff8042; }

.pr-legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.375rem 1rem;
  margin-top: 0.75rem;
  font-size: 12px;
  color: var(--pr-muted);
}

.pr-legend span {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}

.pr-ln {
  display: inline-block;
  width: 18px;
  height: 0;
}

.pr-ln-cap { border-top: 2.5px solid #da70d6; }
.pr-ln-real { border-top: 1.5px dashed var(--pr-muted); }

/* Endpoint table under the tradeoff chart */
.pr-table {
  margin-top: 0.875rem;
  border-top: 1px solid var(--pr-rule);
  font-size: 12px;
}

.pr-row {
  display: grid;
  grid-template-columns: 76px minmax(0, 1fr) 84px;
  gap: 0.5rem;
  align-items: center;
  padding: 0.375rem 0;
  border-bottom: 1px solid var(--pr-rule);
}

.pr-head { color: var(--pr-muted); white-space: nowrap; }
.pr-sub::before { content: ", "; }
.pr-name { font-weight: 600; color: var(--pr-ink); }
.pr-bar { display: flex; height: 10px; }
.pr-bar i { display: block; height: 100%; }
.pr-share { display: flex; align-items: center; gap: 0.375rem; }
.pr-share i { display: block; height: 10px; max-width: 54px; border-radius: 2px; background: var(--pr-muted); opacity: 0.5; }
.pr-share b { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--pr-muted); }

@media (max-width: 560px) {
  .pr-row { grid-template-columns: 76px minmax(0, 1fr) 32px; }
  .pr-share i { display: none; }
  .pr-head { white-space: normal; }
  .pr-sub { display: block; }
  .pr-sub::before { content: none; }
}

/* SVG text shrinks with the figure, so enlarge it on narrow figures. */
@container (max-width: 480px) {
  .pr-fig svg text { font-size: 15px; }
  .pr-fig svg .lbl { font-size: 16px; }
}

@container (max-width: 400px) {
  .pr-fig svg text { font-size: 17px; }
  .pr-fig svg .lbl { font-size: 18px; }
}

/* Mini diagrams */
.pr-mini-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.75rem 1.5rem;
}

.pr-mini-row svg { flex: 0 1 auto; min-width: 0; margin-inline: 0; }

@media (max-width: 640px) {
  .pr-mini-row { flex-wrap: wrap; }
}

.pr-mini .strong-lbl { fill: var(--pr-ink); font-weight: 600; }
.pr-mini .amt { text-anchor: end; font-variant-numeric: tabular-nums; }
.pr-mini .op { font-size: 20px; }
.pr-mini .paper { fill: var(--pr-surface); stroke: var(--pr-rule); stroke-width: 1; }
.pr-mini .usual { stroke: var(--pr-muted); stroke-width: 1; stroke-dasharray: 3 3; }
.pr-mini .sum-line { stroke: var(--pr-ink); stroke-width: 1; }
.pr-mini .price-pill { fill: #0088fe; opacity: 0.12; }
.pr-mini .pill-text { fill: var(--pr-ink); font-weight: 600; font-variant-numeric: tabular-nums; }
.pr-mini .neg-pill { fill: #ff2d55; opacity: 0.12; }
.pr-mini .neg-text { font-size: 13px; fill: var(--pr-negative-text); font-weight: 600; font-variant-numeric: tabular-nums; }
.pr-mini .span-stream { fill: var(--pr-muted); opacity: 0.3; }
.pr-mini .span-total { fill: var(--pr-rule); }
.pr-mini .extra { opacity: 0.45; }
.pr-mini .bad { fill: none; stroke: #ff2d55; stroke-width: 1.5; }
.pr-mini .tree { fill: none; stroke: var(--pr-muted); stroke-width: 1; }
.pr-mini .brace { fill: none; stroke: var(--pr-muted); stroke-width: 1.25; }
.pr-mini .big-arrow { fill: none; stroke: var(--pr-ink); stroke-width: 3; }
.pr-mini .big-arrow-head,
.pr-mini .user-dot { fill: var(--pr-ink); }

/* Color-keyed lists and two-column lists in the page body */
.pr-factors ul {
  list-style: none;
  padding-left: 0;
}

/* Mintlify's prose list pads each item with !important for its dot bullet. */
.pr-factors li {
  padding-left: 0 !important;
}

.pr-factors li::before {
  display: none;
}

.pr-factors .pr-sw,
h3 .pr-sw {
  margin-right: 0.625rem;
  transform: translateY(1px);
}

h3 .pr-sw {
  width: 13px;
  height: 13px;
  transform: translateY(-2px);
}

.pr-cols {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 0 1.75rem;
}
</style><style data-custom-css-index="1" data-custom-css-path="dynamic-tailwind.css">.mint-h-40 {
    height: 10rem
}
.mint-w-full {
    width: 100%
}
@keyframes mint-pulse {
    50% {
        opacity: .5
    }
}
.mint-animate-pulse {
    animation: mint-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite
}
.mint-rounded-lg {
    border-radius: 0.5rem
}</style><!--$--><!--/$--><div class="flex flex-row-reverse gap-12 box-border w-full pt-[calc(10rem+var(--banner-height,2.5rem))] lg:pt-10"><div class="hidden xl:flex self-start sticky xl:flex-col max-w-[28rem] z-21 h-[calc(100vh-9.5rem)] top-[9.5rem] [[data-banner-state=visible]_&amp;]:h-[calc(100vh-12rem)] [[data-banner-state=visible]_&amp;]:top-[12rem]" id="content-side-layout" data-layout-item="side-panel"><div class="z-10 hidden xl:flex box-border max-h-full pl-10 w-[19rem]" id="table-of-contents-layout" data-layout-item="toc"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" id="table-of-contents" data-layout-item="toc-content" data-shell="panel" data-marker="none" data-look="default" class="min-w-0 text-gray-600 text-sm leading-6 w-[16.5rem] -mt-10 group/toc"><div data-id="base-ui-_R_mqelubqoqe9qj4npfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] pt-10 pb-4 base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-0! w-full space-y-2"><nav aria-labelledby="_R_6qelubqoqe9qj4npfiutb_"><h2 id="_R_6qelubqoqe9qj4npfiutb_" data-layout-item="toc-title"><button type="button" aria-describedby="_R_6qelubqoqe9qj4npfiutbH1_"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-TableOfContents"></use></svg><span>On this page</span></button></h2><span id="_R_6qelubqoqe9qj4npfiutbH1_" hidden="">Back to top</span><ul id="table-of-contents-content" class="toc" data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#price-based-load-balancing-default-strategy">Price-Based Load Balancing (Default Strategy)</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#provider-sorting">Provider Sorting</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#nitro-shortcut">Nitro Shortcut</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#floor-price-shortcut">Floor Price Shortcut</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#advanced-sorting-with-partition">Advanced Sorting with Partition</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#use-case-1-route-to-the-highest-throughput-or-lowest-latency-model">Use Case 1: Route to the Highest Throughput or Lowest Latency Model</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#performance-thresholds">Performance Thresholds</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#how-percentiles-work">How Percentiles Work</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#when-to-use-percentile-preferences">When to Use Percentile Preferences</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#use-case-2-find-the-cheapest-model-meeting-performance-requirements">Use Case 2: Find the Cheapest Model Meeting Performance Requirements</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-using-multiple-percentile-cutoffs">Example: Using Multiple Percentile Cutoffs</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#use-case-3-maximize-byok-usage-across-models">Use Case 3: Maximize BYOK Usage Across Models</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#ordering-specific-providers">Ordering Specific Providers</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-specifying-providers-with-fallbacks">Example: Specifying providers with fallbacks</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-specifying-providers-with-fallbacks-disabled">Example: Specifying providers with fallbacks disabled</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#targeting-specific-provider-endpoints">Targeting Specific Provider Endpoints</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#base-slug-matching">Base Slug Matching</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-targeting-a-specific-endpoint-variant">Example: Targeting a specific endpoint variant</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#requiring-providers-to-support-all-parameters">Requiring Providers to Support All Parameters</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#default-parameter-preferences">Default parameter preferences</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-excluding-providers-that-don%E2%80%99t-support-json-formatting">Example: Excluding providers that don’t support JSON formatting</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#requiring-providers-to-comply-with-data-policies">Requiring Providers to Comply with Data Policies</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-excluding-providers-that-don%E2%80%99t-comply-with-data-policies">Example: Excluding providers that don’t comply with data policies</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#zero-data-retention-enforcement">Zero Data Retention Enforcement</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-enforcing-zdr-for-a-specific-request">Example: Enforcing ZDR for a specific request</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#distillable-text-enforcement">Distillable Text Enforcement</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-enforcing-distillable-text-for-a-specific-request">Example: Enforcing distillable text for a specific request</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#disabling-fallbacks">Disabling Fallbacks</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#allowing-only-specific-providers">Allowing Only Specific Providers</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-allowing-azure-for-a-request-calling-gpt-4-omni">Example: Allowing Azure for a request calling GPT-4 Omni</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#ignoring-providers">Ignoring Providers</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-ignoring-deepinfra-for-a-request-calling-llama-3-3-70b">Example: Ignoring DeepInfra for a request calling Llama 3.3 70b</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#quantization">Quantization</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#quantization-levels">Quantization Levels</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#example-requesting-fp8-quantization">Example: Requesting FP8 Quantization</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#max-price">Max Price</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#provider-specific-headers">Provider-Specific Headers</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#anthropic-beta-features">Anthropic Beta Features</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="2"><a data-layout-item="toc-item-link" href="#supported-beta-features">Supported Beta Features</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="2"><a data-layout-item="toc-item-link" href="#example-enabling-interleaved-thinking">Example: Enabling Interleaved Thinking</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="2"><a data-layout-item="toc-item-link" href="#combining-multiple-beta-features">Combining Multiple Beta Features</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#terms-of-service">Terms of Service</a></li></ul></nav></div></div></div></div></div><div class="relative grow box-border flex-col w-full mx-auto px-1 lg:pl-[5.7rem] lg:-ml-12 xl:w-[calc(100%-28rem)] lg:max-w-[calc(var(--content-width,100vw)+5.95rem)]" data-empty-page-layout="" id="content-area" data-layout-item="content"><header id="header" data-layout-item="page-header" class="relative leading-none @container/page-header"><div class="mt-0.5 space-y-2.5"><div class="eyebrow h-5 text-primary dark:text-primary-light text-sm font-semibold">Models &amp; Routing</div><div class="flex flex-col sm:flex-row items-start sm:items-center relative gap-2 min-w-0"><h1 id="page-title" class="text-3xl sm:text-4xl text-gray-900 tracking-tight dark:text-gray-200 [overflow-wrap:anywhere] font-semibold">Provider Routing</h1><div id="page-context-menu" class="items-center shrink-0 min-w-[156px] justify-end ml-auto hidden @[520px]/page-header:flex"><button id="page-context-menu-button" class="rounded-l-xl px-3 text-gray-700 dark:text-gray-300 py-1.5 border border-gray-200 dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5 border-r-0" aria-label="Copy page"><div class="flex items-center gap-2 text-sm text-center font-medium"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0"><use href="#mi-mint-1-Copy"></use></svg><span class="grid"><span aria-hidden="true" class="invisible col-start-1 row-start-1">Copy page</span><span class="col-start-1 row-start-1">Copy page</span></span></div></button><button type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_1ms8qqelubqoqe9qj4npfiutb_" aria-label="More actions" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 overflow-hidden group focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light py-0.5 gap-1 text-sm text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 rounded-none rounded-r-xl border flex items-center justify-center h-[34px] border-gray-200 aspect-square dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5"><svg aria-hidden="true" width="18" height="18" stroke-width="2" focusable="false" class="size-3 transition-transform text-gray-400 group-hover:text-gray-600 dark:text-gray-600 dark:group-hover:text-gray-400 shrink-0 rotate-90"><use href="#mi-mint-1-ChevronRight"></use></svg></button></div></div></div><div class="mt-2 text-lg prose prose-gray dark:prose-invert [&amp;&gt;*]:[overflow-wrap:anywhere]"><p>Route requests to the best provider</p></div><div id="page-context-menu" class="flex items-center shrink-0 min-w-[156px] mt-3 @[520px]/page-header:hidden"><button id="page-context-menu-button" class="rounded-l-xl px-3 text-gray-700 dark:text-gray-300 py-1.5 border border-gray-200 dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5 border-r-0" aria-label="Copy page"><div class="flex items-center gap-2 text-sm text-center font-medium"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0"><use href="#mi-mint-1-Copy"></use></svg><span class="grid"><span aria-hidden="true" class="invisible col-start-1 row-start-1">Copy page</span><span class="col-start-1 row-start-1">Copy page</span></span></div></button><button type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_3coqqelubqoqe9qj4npfiutb_" aria-label="More actions" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 overflow-hidden group focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light py-0.5 gap-1 text-sm text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 rounded-none rounded-r-xl border flex items-center justify-center h-[34px] border-gray-200 aspect-square dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5"><svg aria-hidden="true" width="18" height="18" stroke-width="2" focusable="false" class="size-3 transition-transform text-gray-400 group-hover:text-gray-600 dark:text-gray-600 dark:group-hover:text-gray-400 shrink-0 rotate-90"><use href="#mi-mint-1-ChevronRight"></use></svg></button></div></header><div class="mdx-content @container/columns-container relative mt-8 prose prose-gray dark:prose-invert [contain:inline-size] isolate empty:hidden mb-14" data-page-title="Provider Routing" data-page-href="/guides/routing/provider-selection" id="content"><span data-as="p">OpenRouter routes requests to the best available providers for your model. By default, <a href="#price-based-load-balancing-default-strategy" class="link">requests are load balanced</a> across the top providers to maximize uptime.</span>
<span data-as="p">You can customize how your requests are routed using the <code>provider</code> object in the request body for <a class="link" href="/docs/api/api-reference/chat/create-a-chat-completion">Chat Completions</a>.</span>
<span data-as="p">The <code>provider</code> object can contain the following fields:</span>
<!-- --><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" data-table-wrapper="true" class="min-w-0 [--page-padding:20px] flex w-[calc(100%+(var(--page-padding)*2))] my-[1em] py-[1em] -mx-(--page-padding) max-w-none [contain:inline-size]"><div data-id="base-ui-_R_eaqqelubqoqe9qj4npfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] overflow-y-hidden! base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport" role="region" aria-label="Scrollable table"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="flex"><div class="px-(--page-padding) grow max-w-none table"><table class="m-0 min-w-full w-full max-w-none table [&amp;_th]:text-left [&amp;_td[data-numeric]]:tabular-nums [&amp;_td]:min-w-[150px]"><thead><tr><th>Field</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody><tr><td><code>order</code></td><td>string[]</td><td data-numeric="true">-</td><td>List of provider slugs to try in order (e.g. <code>[&quot;anthropic&quot;, &quot;openai&quot;]</code>). <a href="#ordering-specific-providers" class="link">Learn more</a></td></tr><tr><td><code>allow_fallbacks</code></td><td>boolean</td><td><code>true</code></td><td>Whether to allow backup providers when the primary is unavailable. <a href="#disabling-fallbacks" class="link">Learn more</a></td></tr><tr><td><code>require_parameters</code></td><td>boolean</td><td><code>false</code></td><td>Only use providers that support all parameters in your request. <a href="#requiring-providers-to-support-all-parameters" class="link">Learn more</a></td></tr><tr><td><code>data_collection</code></td><td>”allow” | “deny&quot;</td><td>&quot;allow”</td><td>Control whether to use providers that may store data. <a href="#requiring-providers-to-comply-with-data-policies" class="link">Learn more</a></td></tr><tr><td><code>zdr</code></td><td>boolean</td><td data-numeric="true">-</td><td>Restrict routing to only ZDR (Zero Data Retention) endpoints. <a href="#zero-data-retention-enforcement" class="link">Learn more</a></td></tr><tr><td><code>enforce_distillable_text</code></td><td>boolean</td><td data-numeric="true">-</td><td>Restrict routing to only models that allow text distillation. <a href="#distillable-text-enforcement" class="link">Learn more</a></td></tr><tr><td><code>only</code></td><td>string[]</td><td data-numeric="true">-</td><td>List of provider slugs to allow for this request. <a href="#allowing-only-specific-providers" class="link">Learn more</a></td></tr><tr><td><code>ignore</code></td><td>string[]</td><td data-numeric="true">-</td><td>List of provider slugs to skip for this request. <a href="#ignoring-providers" class="link">Learn more</a></td></tr><tr><td><code>quantizations</code></td><td>string[]</td><td data-numeric="true">-</td><td>List of quantization levels to filter by (e.g. <code>[&quot;int4&quot;, &quot;int8&quot;]</code>). <a href="#quantization" class="link">Learn more</a></td></tr><tr><td><code>sort</code></td><td>string | object</td><td data-numeric="true">-</td><td>Sort providers by price, throughput, or latency. Can be a string (e.g. <code>&quot;price&quot;</code>) or an object with <code>by</code> and <code>partition</code> fields. <a href="#provider-sorting" class="link">Learn more</a></td></tr><tr><td><code>preferred_min_throughput</code></td><td>number | object</td><td data-numeric="true">-</td><td>Preferred minimum throughput (tokens/sec). Can be a number or an object with percentile cutoffs (p50, p75, p90, p99). <a href="#performance-thresholds" class="link">Learn more</a></td></tr><tr><td><code>preferred_max_latency</code></td><td>number | object</td><td data-numeric="true">-</td><td>Preferred maximum latency (seconds). Can be a number or an object with percentile cutoffs (p50, p75, p90, p99). <a href="#performance-thresholds" class="link">Learn more</a></td></tr><tr><td><code>max_price</code></td><td>object</td><td data-numeric="true">-</td><td>The maximum pricing you want to pay for this request. <a href="#max-price" class="link">Learn more</a></td></tr></tbody></table></div></div></div></div>
<div role="note" aria-label="Note" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-blue-200 bg-blue-50 dark:border-blue-900 dark:bg-blue-600/20" data-callout-type="note"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 text-blue-800 dark:text-blue-300"><use href="#mi-mint-1-CalloutNote"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-blue-800 dark:text-blue-300" data-component-part="callout-content"><span data-as="p"><strong>Regional data residency (Business and Enterprise)</strong></span><span data-as="p">OpenRouter supports in-region routing in the EU and US on the Business and Enterprise plans. There is no provider preference or setting to turn on: send the request to <code>https://eu.openrouter.ai</code> or <code>https://us.openrouter.ai</code>, and its prompts and completions are processed entirely within that region. Learn more in the <a class="link" href="/docs/guides/features/in-region-routing">In-Region Routing guide</a>.</span></div></div>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="price-based-load-balancing-default-strategy"><div class="absolute" tabindex="-1"><a href="#price-based-load-balancing-default-strategy" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span class="cursor-pointer">Price-Based Load Balancing (Default Strategy)</span></h2>
<span data-as="p">For each model in your request, OpenRouter’s default behavior is to load balance requests across providers, prioritizing price.</span>
<span data-as="p">If you are more sensitive to throughput than price, you can use the <code>sort</code> field to explicitly prioritize throughput.</span>
<div role="note" aria-label="Tip" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-green-200 bg-green-50 dark:border-green-900 dark:bg-green-600/20 [&amp;_[data-component-part=&#x27;callout-icon&#x27;]]:mt-px" data-callout-type="tip"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4.5 text-green-800 dark:text-green-300"><use href="#mi-mint-1-CalloutTip"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-green-800 dark:text-green-300" data-component-part="callout-content"><span data-as="p">When you send a request with <code>tools</code> or <code>tool_choice</code>, OpenRouter makes a best effort to route to providers known to support tool use. Similarly, if you set a <code>max_tokens</code>, then OpenRouter will only route to providers that support a response of that length.</span></div></div>
<span data-as="p">Here is OpenRouter’s default load balancing strategy:</span>
<ol>
<li>Prioritize providers that have not seen significant outages in the last 30 seconds.</li>
<li>For the stable providers, look at the lowest-cost candidates and select one weighted by inverse square of the price (example below).</li>
<li>Use the remaining providers as fallbacks.</li>
</ol>
<div role="note" aria-label="Note" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-blue-200 bg-blue-50 dark:border-blue-900 dark:bg-blue-600/20" data-callout-type="note"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 text-blue-800 dark:text-blue-300"><use href="#mi-mint-1-CalloutNote"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-blue-800 dark:text-blue-300" data-component-part="callout-content"><span data-as="p"><strong>A Load Balancing Example</strong></span><span data-as="p">If Provider A costs $1 per million tokens, Provider B costs $2, and Provider C costs $3, and Provider B recently saw a few outages.</span><ul>
<li>Your request is most likely routed to Provider A first. Provider A is 9x more likely than Provider C to be routed to first, because each provider is weighted by the inverse square of its price: <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mn>1</mn><mi mathvariant="normal">/</mi><msup><mn>1</mn><mn>2</mn></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">1 / 1^2 = 1</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:1.0641em;vertical-align:-0.25em"></span><span class="mord">1/</span><span class="mord"><span class="mord">1</span><span class="msupsub"><span class="vlist-t"><span class="vlist-r"><span class="vlist" style="height:0.8141em"><span style="top:-3.063em;margin-right:0.05em"><span class="pstrut" style="height:2.7em"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">2</span></span></span></span></span></span></span></span><span class="mspace" style="margin-right:0.2778em"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em"></span></span><span class="base"><span class="strut" style="height:0.6444em"></span><span class="mord">1</span></span></span></span> for Provider A vs. <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mn>1</mn><mi mathvariant="normal">/</mi><msup><mn>3</mn><mn>2</mn></msup><mo>=</mo><mn>1</mn><mi mathvariant="normal">/</mi><mn>9</mn></mrow><annotation encoding="application/x-tex">1 / 3^2 = 1/9</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:1.0641em;vertical-align:-0.25em"></span><span class="mord">1/</span><span class="mord"><span class="mord">3</span><span class="msupsub"><span class="vlist-t"><span class="vlist-r"><span class="vlist" style="height:0.8141em"><span style="top:-3.063em;margin-right:0.05em"><span class="pstrut" style="height:2.7em"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">2</span></span></span></span></span></span></span></span><span class="mspace" style="margin-right:0.2778em"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em"></span></span><span class="base"><span class="strut" style="height:1em;vertical-align:-0.25em"></span><span class="mord">1/9</span></span></span></span> for Provider C.</li>
<li>If Provider A fails, then Provider C will be tried next.</li>
<li>If Provider C also fails, Provider B will be tried last.</li>
</ul></div></div>
<span data-as="p">If you have <code>sort</code> or <code>order</code> set in your provider preferences, load balancing will be disabled.</span>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="provider-sorting"><div class="absolute" tabindex="-1"><a href="#provider-sorting" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span class="cursor-pointer">Provider Sorting</span></h2>
<span data-as="p">As described above, OpenRouter load balances based on price, while taking uptime into account.</span>
<span data-as="p">If you instead want to <em>explicitly</em> prioritize a particular provider attribute, you can include the <code>sort</code> field in the <code>provider</code> preferences. Load balancing will be disabled, and the router will try providers in order.</span>
<span data-as="p">The three sort options are:</span>
<ul>
<li><code>&quot;price&quot;</code>: prioritize lowest price</li>
<li><code>&quot;throughput&quot;</code>: prioritize highest throughput</li>
<li><code>&quot;latency&quot;</code>: prioritize lowest latency</li>
</ul>
