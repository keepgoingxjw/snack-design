<span class="line"><span style="color:#0A3069;--shiki-dark:#CE9178">    &#x27;data_collection&#x27;</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: </span><span style="color:#0A3069;--shiki-dark:#CE9178">&#x27;deny&#x27;</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">, </span><span style="color:#6E7781;--shiki-dark:#6A9955"># or &quot;allow&quot;</span></span>
