<span class="line"><span style="color:#1F2328;--shiki-dark:#D4D4D4">response </span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#1F2328;--shiki-dark:#D4D4D4"> requests.post(</span><span style="color:#0A3069;--shiki-dark:#CE9178">&#x27;https://openrouter.ai/api/v1/chat/completions&#x27;</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">, </span><span style="color:#953800;--shiki-dark:#9CDCFE">headers</span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">headers, </span><span style="color:#953800;--shiki-dark:#9CDCFE">json</span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">{</span></span>
