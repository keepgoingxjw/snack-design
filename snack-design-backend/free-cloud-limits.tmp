    background-color: rgb(17 24 39 / var(--tw-bg-opacity, 1))
}
.dark\:mint-text-gray-100:is(.dark *) {
    --tw-text-opacity: 1;
    color: rgb(243 244 246 / var(--tw-text-opacity, 1))
}
.dark\:mint-text-gray-400:is(.dark *) {
    --tw-text-opacity: 1;
    color: rgb(156 163 175 / var(--tw-text-opacity, 1))
}</style><!--$--><!--/$--><div class="flex flex-row-reverse gap-12 box-border w-full pt-[calc(10rem+var(--banner-height,2.5rem))] lg:pt-10"><div class="hidden xl:flex self-start sticky xl:flex-col max-w-[28rem] z-21 h-[calc(100vh-9.5rem)] top-[9.5rem] [[data-banner-state=visible]_&amp;]:h-[calc(100vh-12rem)] [[data-banner-state=visible]_&amp;]:top-[12rem]" id="content-side-layout" data-layout-item="side-panel"><div class="z-10 hidden xl:flex box-border max-h-full pl-10 w-[19rem]" id="table-of-contents-layout" data-layout-item="toc"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" id="table-of-contents" data-layout-item="toc-content" data-shell="panel" data-marker="none" data-look="default" class="min-w-0 text-gray-600 text-sm leading-6 w-[16.5rem] -mt-10 group/toc"><div data-id="base-ui-_R_mqelubqoqe9qj4npfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] pt-10 pb-4 base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-0! w-full space-y-2"><nav aria-labelledby="_R_6qelubqoqe9qj4npfiutb_"><h2 id="_R_6qelubqoqe9qj4npfiutb_" data-layout-item="toc-title"><button type="button" aria-describedby="_R_6qelubqoqe9qj4npfiutbH1_"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-TableOfContents"></use></svg><span>On this page</span></button></h2><span id="_R_6qelubqoqe9qj4npfiutbH1_" hidden="">Back to top</span><ul id="table-of-contents-content" class="toc" data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#checking-your-limits">Checking your limits</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#credit-limits">Credit limits</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#in-flight-spending-budget">In-flight spending budget</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#handling-402-errors">Handling 402 errors</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#budget-limits">Budget limits</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#checking-your-budgets">Checking your budgets</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#handling-403-budget-errors">Handling 403 budget errors</a></li></ul></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#rate-limits">Rate limits</a><ul data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="1"><a data-layout-item="toc-item-link" href="#handling-429-errors">Handling 429 errors</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="2"><a data-layout-item="toc-item-link" href="#mid-stream-rate-limits">Mid-stream rate limits</a></li></ul></li></ul></nav></div></div></div></div></div><div class="relative grow box-border flex-col w-full mx-auto px-1 lg:pl-[5.7rem] lg:-ml-12 xl:w-[calc(100%-28rem)] lg:max-w-[calc(var(--content-width,100vw)+5.95rem)]" data-empty-page-layout="" id="content-area" data-layout-item="content"><header id="header" data-layout-item="page-header" class="relative leading-none @container/page-header"><div class="mt-0.5 space-y-2.5"><div class="eyebrow h-5 text-primary dark:text-primary-light text-sm font-semibold">API Guides</div><div class="flex flex-col sm:flex-row items-start sm:items-center relative gap-2 min-w-0"><h1 id="page-title" class="text-3xl sm:text-4xl text-gray-900 tracking-tight dark:text-gray-200 [overflow-wrap:anywhere] break-all font-semibold">Limits</h1><div id="page-context-menu" class="items-center shrink-0 min-w-[156px] justify-end ml-auto hidden @[520px]/page-header:flex"><button id="page-context-menu-button" class="rounded-l-xl px-3 text-gray-700 dark:text-gray-300 py-1.5 border border-gray-200 dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5 border-r-0" aria-label="Copy page"><div class="flex items-center gap-2 text-sm text-center font-medium"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0"><use href="#mi-mint-1-Copy"></use></svg><span class="grid"><span aria-hidden="true" class="invisible col-start-1 row-start-1">Copy page</span><span class="col-start-1 row-start-1">Copy page</span></span></div></button><button type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_1ms8qqelubqoqe9qj4npfiutb_" aria-label="More actions" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 overflow-hidden group focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light py-0.5 gap-1 text-sm text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 rounded-none rounded-r-xl border flex items-center justify-center h-[34px] border-gray-200 aspect-square dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5"><svg aria-hidden="true" width="18" height="18" stroke-width="2" focusable="false" class="size-3 transition-transform text-gray-400 group-hover:text-gray-600 dark:text-gray-600 dark:group-hover:text-gray-400 shrink-0 rotate-90"><use href="#mi-mint-1-ChevronRight"></use></svg></button></div></div></div><div class="mt-2 text-lg prose pro