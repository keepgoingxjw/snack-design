c/chunks/aef4c95688a888c9.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/936c15c865561b39.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/f5de7c584a7242d5.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/fa4ecd6148999d3b.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/de1844e894616c9b.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/1218b43cc3036511.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/46412fc451e7a566.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/6daa732cc8189895.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/d2a27a5bb18658c3.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/0ec3a60b871650b1.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/e07fdeaa7fc096e9.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/7ee0ca90baec9f72.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/64ec75202bfdbf9e.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/0b14b857c1e98c0e.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/ef805e255b871a7e.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/4be2f5c8ac27d5d3.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/c3f358330ac4cf47.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/5fd1092da631a2eb.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/5ac81d523ab60e9d.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/3429f0e1889e4c1a.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\",\"/docs/_next/static/chunks/55bd7cebf7c5b56c.js?dpl=dpl_7ybN9fNDB7djqPULpsARBCQXzEDN\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"53:[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L58\",null,{\"pageMetadata\":\"$4c:props:pageMetadata\"}]]\n54:[\"$\",\"$L59\",null,{\"pageMetadata\":\"$4c:props:pageMetadata\"}]\n5b:T3e7c,"])</script><script>self.__next_f.push([1,"/*\n * OpenRouter Docs — Bauhaus theme overrides\n *\n * Custom CSS for Mintlify to align with the bauhaus design system.\n * Uses Mintlify's exposed ID/element selectors for targeted styling.\n *\n * Brand palette:\n *   Ink #03080A   Cloud #FCFCFE   Grape #7624F4\n *   Volt #C8FF00  Coral #FF6849   Royal #035ADE\n */\n\n/* ── Code font: Geist Mono ── */\n@import url('https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600\u0026display=swap');\n\n/*\n * Inverse semantic pair mirrors packages/frontend/components/ui/theme.css.\n * Mintlify is a separate app, so its generated tooltip DOM uses the same\n * light Ink/Cloud and dark Cloud/Ink values through RGB channel variables.\n */\n:root {\n  --inverse: 3 8 10;\n  --inverse-foreground: 252 252 254;\n  --tooltip-background: var(--inverse);\n  --tooltip-foreground: var(--inverse-foreground);\n}\n\ncode,\npre,\npre code,\n.code-block code,\n[class*=\"code\"] code {\n  font-family: 'Geist Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;\n}\n\n/* ── Text selection: accent tint per DESIGN.md ── */\n::selection {\n  background: rgb(118 36 244 / 0.25);\n}\n\n.dark ::selection,\nhtml.dark ::selection {\n  background: rgb(200 255 0 / 0.25);\n  color: inherit;\n}\n\n/* ── Dark-mode accent swap: Volt (#C8FF00 = rgb(200 255 0)) per DESIGN.md ──\n * Mintlify + Tailwind use space-separated RGB: rgb(var(--primary-light) / alpha).\n * Override accent in dark mode from Grape to Volt. */\n.dark,\n[data-theme=\"dark\"],\nhtml.dark {\n  --primary: 200 255 0;\n  --primary-light: 200 255 0;\n  --primary-dark: 200 255 0;\n  --light-primary: 200 255 0;\n  --primary-foreground: 3 8 10;\n  --inverse: 252 252 254;\n  --inverse-foreground: 3 8 10;\n\n  /* ── Dark-mode border: Cloud at 14% per DESIGN.md ── */\n  --default-border-color: rgb(252 252 254 / 0.14);\n}\n\n/* ── Border radius: bauhaus 4/6/8px scale ── */\n#navbar {\n  border-radius: 0;\n}\n\n/* Sidebar active item */\n#sidebar a[aria-current=\"page\"],\nnav[aria-label=\"Pages\"] a[aria-current=\"page\"] {\n  border-radius: 8px;\n}\n\n/* Cards and code blocks */\n[data-component-part=\"code-block-root\"] {\n  border-radius: 8px;\n}\n\n/* ── Link styling per DESIGN.md ──\n * underline at 40% opacity of current color, full on hover, offset 2px */\na:not([class]) {\n  text-decoration-thickness: 1px;\n  text-underline-offset: 2px;\n  text-decoration-color: rgb(0 0 0 / 0.4);\n}\n\na:not([class]):hover {\n  text-decoration-color: currentColor;\n}\n\n.dark a:not([class]),\nhtml.dark a:not([class]) {\n  text-decoration-color: rgb(255 255 255 / 0.4);\n}\n\n.dark a:not([class]):hover,\nhtml.dark a:not([class]):hover {\n  text-decoration-color: currentColor;\n}\n\n/* ── Sidebar badges: outline style ── */\n.nav-tag-pill-text {\n  background: transparent !important;\n  color: rgb(0 0 0 / 0.5) !important;\n  border: 1px solid rgb(0 0 0 / 0.2) !important;\n}\n\n.dark .nav-tag-pill-text,\nhtml.dark .nav-tag-pill-text {\n  background: transparent !important;\n  color: rgb(252 252 254 / 0.5) !important;\n  border: 1px solid rgb(252 252 254 / 0.2) !important;\n}\n\n/* Match the home navbar logo height (h-6 / 1.5rem). */\n.nav-logo {\n  height: 1.5rem;\n}\n\n/* ── Sidebar expand chevrons: raise dark-mode contrast ──\n * Collapsible group toggles render a caret whose default dark tone\n * (gray-600 on Ink) is nearly invisible, so it isn't clear which items\n * have subsections. Derive the caret from Cloud via the DESIGN.md opacity\n * scale: muted-foreground (Cloud `a0`) at rest, full Cloud (foreground) on\n * hover — no custom hex outside the brand palette. */\n.dark nav[aria-label=\"Pages\"] button[aria-expanded] svg.transition-transform,\nhtml.dark nav[aria-label=\"Pages\"] button[aria-expanded] svg.transition-transform {\n  color: rgb(252 252 254 / 0.627);\n}\n\n.dark nav[aria-label=\"Pages\"] button[aria-expanded]:hover svg.transition-transform,\nhtml.dark nav[aria-label=\"Pages\"] button[aria-expanded]:hover svg.transition-transform {\n  color: rgb(252 252 254);\n}\n\n/* ── Sidebar expand chevrons: enlarge for legibility ──\n * The default caret (w-2 ≈ 8px) is easy to miss; bump its footprint so it\n * reads clearly as an expandable affordance. */\nnav[aria-label=\"Pages\"] button[aria-expanded] svg.transition-transform {\n  width: 0.625rem;\n  height: 0.625rem;\n}\n\n/* ── Tooltips: inverse surface pairing ──\n * Mintlify has a foreground variable for tooltips but no matching background\n * variable, so both values are mirrored here from the inverse pair. Its\n * tooltip popup renders through Base UI (role=\"tooltip\" on a data-side popup\n * filled with bg-primary-dark, which is Volt in dark mode); the Radix\n * selectors cover the previous implementation. */\n[role=\"tooltip\"][data-side],\n[data-radix-popper-content-wrapper]\n  \u003e div[data-state=\"delayed-open\"],\n[data-radix-popper-content-wrapper]\n  \u003e div[data-state=\"instant-open\"] {\n  background-color: rgb(var(--tooltip-background)) !important;\n  color: rgb(var(--tooltip-foreground)) !important;\n}\n\n/* ── Callout + code block alignment ──\n * A code block that is the only child of a callout body carries Mintlify's default\n * prose margins (mt-5 mb-8), which push the snippet down so it no longer lines\n * up with the top-aligned callout icon. Drop those margins so the snippet's\n * top edge aligns with the icon. */\n.callout [data-component-part=\"callout-content\"] \u003e .code-block:first-child {\n  margin-top: 0;\n}\n\n.callout [data-component-part=\"callout-content\"] \u003e .code-block:last-child {\n  margin-bottom: 0;\n}\n\n/* ── Floating code-block buttons: opaque background ──\n * Mintlify only backs the floating buttons (report / copy / ask) with\n * gray-100/gray-800 when the code block has no fade overlay\n * (group-[:not(:has([data-fade-overlay]))]). Collapsible/expandable blocks\n * always carry a fade overlay, so the buttons stay transparent and the code\n * text bleeds through behind them. Apply the same background unconditionally\n * so the buttons are legible on every code block. */\n[data-floating-buttons] button {\n  background-color: rgb(241 239 245);\n}\n\n.dark [data-floating-buttons] button,\nhtml.dark [data-floating-buttons] button {\n  background-color: rgb(40 38 44);\n}\n\n/* ── Changelog: Update tags as outline pills (matches sidebar badges) ── */\n[data-component-part=\"update-tag\"] {\n  border: 1px solid rgb(0 0 0 / 0.2);\n  border-radius: 9999px;\n  padding: 0.125rem 0.625rem;\n  font-size: 0.75rem;\n  line-height: 1.25rem;\n  color: rgb(0 0 0 / 0.6);\n}\n\n.dark [data-component-part=\"update-tag\"],\nhtml.dark [data-component-part=\"update-tag\"] {\n  border-color: rgb(252 252 254 / 0.2);\n  color: rgb(252 252 254 / 0.6);\n}\n\n/* ── Navbar CTA: drop the chevron, pair label and background per theme ──\n * Mintlify renders the primary CTA with a trailing chevron, a text-white\n * label, and a bg-primary-dark fill in both themes (primary-dark maps to\n * docs.json colors.dark = Volt). Per DESIGN.md the pairings are white on\n * Grape in light mode and Ink on Volt in dark mode, which is exactly what\n * --primary already resolves to (Grape from docs.json, Volt via the\n * dark-mode swap above). */\n#topbar-cta-button svg {\n  display: none;\n}\n\n/* Mintlify pads the CTA pl-3/pr-2 to hug the chevron; even it out. */\n#topbar-cta-button a {\n  padding-right: 0.75rem;\n}\n\n#topbar-cta-button .bg-primary-dark {\n  background-color: rgb(var(--primary));\n}\n\n.dark #topbar-cta-button .text-white,\nhtml.dark #topbar-cta-button .text-white {\n  color: rgb(3 8 10);\n}\n\n/* ── Changelog: selected filter pill readability ──\n * Mintlify renders the active filter as bg-primary + text-white/90. In dark\n * mode our primary is Volt (#C8FF00), so switch the text to Ink per DESIGN.md. */\n.dark #changelog-filters-content button.bg-primary,\nhtml.dark #changelog-filters-content button.bg-primary {\n  color: rgb(3 8 10 / 0.9) !important;\n}\n\n/* ── Changelog: separate inline status badges from bullet text ── */\n.changelog-status-badge {\n  margin-left: 0.5rem;\n}\n\n.changelog-status-badge[data-color=\"gray\"] {\n  border: 1px solid rgb(3 8 10 / 0.3) !important;\n}\n\n.dark .changelog-status-badge[data-color=\"gray\"],\nhtml.dark .changelog-status-badge[data-color=\"gray\"] {\n  border-color: rgb(252 252 254 / 0.4) !important;\n}\n\n/* ── Mermaid: center diagrams in the content column ── */\n.mermaid \u003e svg {\n  margin-inline: auto;\n}\n\n/* ── Compact support matrices ──\n * Mintlify gives every table cell a 150px minimum width, which forces a\n * six-column check/dash table to scroll horizontally in the content column.\n * Cells in a support matrix hold an icon or a short field name, so let them\n * shrink to their content. */\n.support-matrix table {\n  font-size: 0.8125rem;\n}\n\n.support-matrix td,\n.support-matrix th {\n  min-width: 0;\n  padding-right: 0.5rem;\n  white-space: nowrap;\n}\n\n.support-matrix th code {\n  padding-left: 0.25rem;\n  padding-right: 0.25rem;\n  font-size: 0.6875rem;\n}\n\n/* ── Provider routing figures ──\n * Inline SVG illustrations from snippets/exports/ProviderRoutingFigures.jsx.\n * Part colors match the provider dashboard's FortunaBCostBar (chart-1, chart-3,\n * chart-12, negative, chart-4) and its competitive zone (positive); chart\n * colors are the same hex in both themes, so only neutrals change with it. */\n.pr-fig,\n.pr-mini {\n  --pr-ink: #03080a;\n  --pr-muted: rgb(3 8 10 / 0.69);\n  --pr-rule: rgb(3 8 10 / 0.12);\n  --pr-surface: #ffffff;\n  --pr-positive-text: #007544;\n  --pr-negative-text: #bf0024;\n}\n\n.dark .pr-fig,\n.dark .pr-mini {\n  --pr-ink: #fcfcfe;\n  --pr-muted: rgb(252 252 254 / 0.627);\n  --pr-rule: rgb(252 252 254 / 0.14);\n  --pr-surface: #080d0f;\n  --pr-positive-text: #34dfaa;\n  --pr-negative-text: #ff2d55;\n}\n\n.pr-fig {\n  margin: 1.5rem 0;\n  padding: 1rem;\n  overflow-x: auto;\n  container-type: inline-size;\n  border: 1px solid var(--pr-rule);\n  border-radius: 8px;\n  background: var(--pr-surface);\n}\n\n.pr-fig svg {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n.pr-mini {\n  margin: 1rem 0 1.25rem;\n}\n\n.pr-mini svg {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  margin-inline: auto;\n}\n\n.pr-fig svg text,\n.pr-mini svg text {\n  font-family: inherit;\n  font-size: 12px;\n  fill: var(--pr-muted);\n}\n\n.pr-sw {\n  display: inline-block;\n  flex: none;\n  width: 12px;\n  height: 12px;\n  border-radius: 2px;\n}\n\n.pr-bg-price { background: #0088fe; }\n.pr-bg-ttft { background: #ffbb28; }\n.pr-bg-speed { background: #7b68ee; }\n.pr-bg-rel { background: #ff2d55; }\n.pr-bg-429 { background: #ff8042; }\n.pr-bg-received { background: var(--pr-ink); }\n/* Learned capacity is a limit, not a cost part, so its heading swatch is neutral. */\n.pr-bg-capacity { background: rgb(var(--gray-400)); }\n\n.pr-fill-ttft { fill: #ffbb28; }\n.pr-fill-speed { fill: #7b68ee; }\n.pr-fill-rel { fill: #ff2d55; }\n.pr-fill-429 { fill: #ff8042; }\n\n/* Charts */\n.pr-fig .lbl { font-size: 13px; fill: var(--pr-ink); }\n.pr-fig .num { fill: var(--pr-muted); font-variant-numeric: tabular-nums; }\n.pr-fig .strong { fill: var(--pr-ink); font-weight: 600; }\n.pr-fig .halo { paint-order: stroke; stroke: var(--pr-surface); stroke-width: 4px; stroke-linejoin: round; }\n.pr-fig .axis { stroke: var(--pr-rule); stroke-width: 1; }\n.pr-fig .zone { fill: rgb(0 191 111 / 0.12); }\n.pr-fig .zone-lbl { font-weight: 600; fill: var(--pr-positive-text); }\n.pr-fig .zone-lbl.muted { fill: var(--pr-muted); }\n.pr-fig .edge { stroke: #00bf6f; stroke-width: 1.5; stroke-dasharray: 4 3; }\n.pr-fig .edge-curve { fill: none; stroke: #00bf6f; stroke-width: 2; stroke-dasharray: 5 3; }\n.pr-fig .curve { fill: none; stroke: var(--pr-ink); stroke-width: 2.5; }\n.pr-fig .curve-fill { fill: var(--pr-ink); opacity: 0.04; }\n.pr-fig .dot { fill: var(--pr-muted); fill-opacity: 0.8; stroke: var(--pr-surface); stroke-width: 1.5; }\n.pr-fig .dot-in { fill: #00bf6f; stroke: var(--pr-surface); stroke-width: 1.5; }\n.pr-fig .got { fill: none; stroke: var(--pr-ink); stroke-width: 2; }\n.pr-fig .got-fill { fill: var(--pr-ink); opacity: 0.06; }\n.pr-fig .cap { fill: none; stroke: #da70d6; stroke-width: 2.5; }\n.pr-fig .real { fill: none; stroke: var(--pr-muted); stroke-width: 1.5; stroke-dasharray: 5 4; }\n.pr-fig .rate { fill: #ff8042; }\n\n.pr-legend {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 0.375rem 1rem;\n  margin-top: 0.75rem;\n  font-size: 12px;\n  color: var(--pr-muted);\n}\n\n.pr-legend span {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n}\n\n.pr-ln {\n  display: inline-block;\n  width: 18px;\n  height: 0;\n}\n\n.pr-ln-cap { border-top: 2.5px solid #da70d6; }\n.pr-ln-real { border-top: 1.5px dashed var(--pr-muted); }\n\n/* Endpoint table under the tradeoff chart */\n.pr-table {\n  margin-top: 0.875rem;\n  border-top: 1px solid var(--pr-rule);\n  font-size: 12px;\n}\n\n.pr-row {\n  display: grid;\n  grid-template-columns: 76px minmax(0, 1fr) 84px;\n  gap: 0.5rem;\n  align-items: center;\n  padding: 0.375rem 0;\n  border-bottom: 1px solid var(--pr-rule);\n}\n\n.pr-head { color: var(--pr-muted); white-space: nowrap; }\n.pr-sub::before { content: \", \"; }\n.pr-name { font-weight: 600; color: var(--pr-ink); }\n.pr-bar { display: flex; height: 10px; }\n.pr-bar i { display: block; height: 100%; }\n.pr-share { display: flex; align-items: center; gap: 0.375rem; }\n.pr-share i { display: block; height: 10px; max-width: 54px; border-radius: 2px; background: var(--pr-muted); opacity: 0.5; }\n.pr-share b { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--pr-muted); }\n\n@media (max-width: 560px) {\n  .pr-row { grid-template-columns: 76px minmax(0, 1fr) 32px; }\n  .pr-share i { display: none; }\n  .pr-head { white-space: normal; }\n  .pr-sub { display: block; }\n  .pr-sub::before { content: none; }\n}\n\n/* SVG text shrinks with the figure, so enlarge it on narrow figures. */\n@container (max-width: 480px) {\n  .pr-fig svg text { font-size: 15px; }\n  .pr-fig svg .lbl { font-size: 16px; }\n}\n\n@container (max-width: 400px) {\n  .pr-fig svg text { font-size: 17px; }\n  .pr-fig svg .lbl { font-size: 18px; }\n}\n\n/* Mini diagrams */\n.pr-mini-row {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 0.75rem 1.5rem;\n}\n\n.pr-mini-row svg { flex: 0 1 auto; min-width: 0; margin-inline: 0; }\n\n@media (max-width: 640px) {\n  .pr-mini-row { flex-wrap: wrap; }\n}\n\n.pr-mini .strong-lbl { fill: var(--pr-ink); font-weight: 600; }\n.pr-mini .amt { text-anchor: end; font-variant-numeric: tabular-nums; }\n.pr-mini .op { font-size: 20px; }\n.pr-mini .paper { fill: var(--pr-surface); stroke: var(--pr-rule); stroke-width: 1; }\n.pr-mini .usual { stroke: var(--pr-muted); stroke-width: 1; stroke-dasharray: 3 3; }\n.pr-mini .sum-line { stroke: var(--pr-ink); stroke-width: 1; }\n.pr-mini .price-pill { fill: #0088fe; opacity: 0.12; }\n.pr-mini .pill-text { fill: var(--pr-ink); font-weight: 600; font-variant-numeric: tabular-nums; }\n.pr-mini .neg-pill { fill: #ff2d55; opacity: 0.12; }\n.pr-mini .neg-text { font-size: 13px; fill: var(--pr-negative-text); font-weight: 600; font-variant-numeric: tabular-nums; }\n.pr-mini .span-stream { fill: var(--pr-muted); opacity: 0.3; }\n.pr-mini .span-total { fill: var(--pr-rule); }\n.pr-mini .extra { opacity: 0.45; }\n.pr-mini .bad { fill: none; stroke: #ff2d55; stroke-width: 1.5; }\n.pr-mini .tree { fill: none; stroke: var(--pr-muted); stroke-width: 1; }\n.pr-mini .brace { fill: none; stroke: var(--pr-muted); stroke-width: 1.25; }\n.pr-mini .big-arrow { fill: none; stroke: var(--pr-ink); stroke-width: 3; }\n.pr-mini .big-arrow-head,\n.pr-mini .user-dot { fill: var(--pr-ink); }\n\n/* Color-keyed lists and two-column lists in the page body */\n.pr-factors ul {\n  list-style: none;\n  padding-left: 0;\n}\n\n/* Mintlify's prose list pads each item with !important for its dot bullet. */\n.pr-factors li {\n  padding-left: 0 !important;\n}\n\n.pr-factors li::before {\n  display: none;\n}\n\n.pr-factors .pr-sw,\nh3 .pr-sw {\n  margin-right: 0.625rem;\n  transform: translateY(1px);\n}\n\nh3 .pr-sw {\n  width: 13px;\n  height: 13px;\n  transform: translateY(-2px);\n}\n\n.pr-cols {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 0 1.75rem;\n}\n"])</script><script>self.__next_f.push([1,"5c:T86c,"])</script><script>self.__next_f.push([1,".mint-fixed {\n    position: fixed\n}\n.mint-relative {\n    position: relative\n}\n.mint-z-50 {\n    z-index: 50\n}\n.mint-mb-1 {\n    margin-bottom: 0.25rem\n}\n.mint-block {\n    display: block\n}\n.mint-inline-block {\n    display: inline-block\n}\n.mint-flex {\n    display: flex\n}\n.mint-cursor-help {\n    cursor: help\n}\n.mint-items-baseline {\n    align-items: baseline\n}\n.mint-gap-2 {\n    gap: 0.5rem\n}\n.mint-rounded-lg {\n    border-radius: 0.5rem\n}\n.mint-border {\n    border-width: 1px\n}\n.mint-border-gray-950\\/10 {\n    border-color: rgb(3 7 18 / 0.1)\n}\n.mint-bg-white {\n    --tw-bg-opacity: 1;\n    background-color: rgb(255 255 255 / var(--tw-bg-opacity, 1))\n}\n.mint-p-3 {\n    padding: 0.75rem\n}\n.mint-text-left {\n    text-align: left\n}\n.mint-text-sm {\n    font-size: 0.875rem;\n    line-height: 1.25rem\n}\n.mint-text-xs {\n    font-size: 0.75rem;\n    line-height: 1rem\n}\n.mint-font-normal {\n    font-weight: 400\n}\n.mint-font-semibold {\n    font-weight: 600\n}\n.mint-leading-relaxed {\n    line-height: 1.625\n}\n.mint-text-gray-600 {\n    --tw-text-opacity: 1;\n    color: rgb(75 85 99 / var(--tw-text-opacity, 1))\n}\n.mint-text-gray-900 {\n    --tw-text-opacity: 1;\n    color: rgb(17 24 39 / var(--tw-text-opacity, 1))\n}\n.mint-underline {\n    text-decoration-line: underline\n}\n.mint-decoration-dotted {\n    text-decoration-style: dotted\n}\n.mint-underline-offset-4 {\n    text-underline-offset: 4px\n}\n.mint-shadow-lg {\n    --tw-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\n    --tw-shadow-colored: 0 10px 15px -3px var(--tw-shadow-color), 0 4px 6px -4px var(--tw-shadow-color);\n    box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)\n}\n.dark\\:mint-border-white\\/10:is(.dark *) {\n    border-color: rgb(255 255 255 / 0.1)\n}\n.dark\\:mint-bg-gray-900:is(.dark *) {\n    --tw-bg-opacity: 1;\n    background-color: rgb(17 24 39 / var(--tw-bg-opacity, 1))\n}\n.dark\\:mint-text-gray-100:is(.dark *) {\n    --tw-text-opacity: 1;\n    color: rgb(243 244 246 / var(--tw-text-opacity, 1))\n}\n.dark\\:mint-text-gray-400:is(.dark *) {\n    --tw-text-opacity: 1;\n    color: rgb(156 163 175 / var(--tw-text-opacity, 1))\n}"])</script><script>self.__next_f.push([1,"55:[\"$\",\"$L5a\",null,{\"cssFiles\":[{\"_id\":\"6a4ae444a41e1483552ac1f2\",\"filePath\":\"style.css\",\"subdomain\":\"openrouter-d02e98a0\",\"__v\":0,\"content\":\"$5b\"},{\"filePath\":\"dynamic-tailwind.css\",\"content\":\"$5c\"}]}]\n5e:T5b9,"])</script><script>self.__next_f.push([1,"/*\n * Deep links (e.g. #response-data-pricing-overrides) can land behind the\n * sticky navbar: the browser scrolls to the anchor before hydration and\n * font loading finish, and the subsequent layout shift moves the target\n * up underneath the header. Re-align the anchor once the page has fully\n * settled, unless the user has already scrolled on their own.\n */\nlet didUserScrollAway = false;\n\nfunction markUserScrollAway() {\n  didUserScrollAway = true;\n}\n\nfunction anchorIdFromHash() {\n  const rawId = window.location.hash.slice(1);\n  try {\n    return decodeURIComponent(rawId);\n  } catch {\n    return rawId;\n  }\n}\n\nfunction realignAnchor() {\n  if (didUserScrollAway) {\n    return;\n  }\n  const target = document.querySelector(`[id=\"${CSS.escape(anchorIdFromHash())}\"]`);\n  // scrollIntoView respects the target's CSS scroll-margin-top,\n  // which Mintlify sets to clear the sticky navbar.\n  target?.scrollIntoView();\n}\n\nasync function settleAnchorScroll() {\n  await (document.fonts?.ready ?? Promise.resolve());\n  setTimeout(realignAnchor, 150);\n}\n\nfunction initAnchorScrollFix() {\n  if (!window.location.hash) {\n    return;\n  }\n  for (const event of ['wheel', 'touchmove', 'keydown']) {\n    window.addEventListener(event, markUserScrollAway, { passive: true, once: true });\n  }\n  if (document.readyState === 'complete') {\n    settleAnchorScroll();\n  } else {\n    window.addEventListener('load', settleAnchorScroll, { once: true });\n  }\n}\n\ninitAnchorScrollFix();\n"])</script><script>self.__next_f.push([1,"5f:T9bd,"])</script><script>self.__next_f.push([1,"/*\n * The navbar CTA in docs.json is a static \"Sign In\" button. The docs are\n * served same-origin under openrouter.ai, so Clerk's JS-readable\n * `__client_uat` cookie (a sign-in timestamp, `0` or absent when signed\n * out, possibly suffixed with a publishable-key hash) tells us whether\n * the reader is signed in.\n *\n * Signed out: keep \"Sign In\" but carry the current docs page as Clerk's\n * `redirect_url`, so signing in returns the reader to where they were.\n * Signed in: repoint the CTA to \"Home\", which — like the signed-in \"Home\"\n * link in the web app's own navbar — lands on the workspace list rather\n * than the marketing homepage.\n *\n * Mintlify's navbar is React-rendered, so a MutationObserver reapplies\n * the target whenever client-side navigation re-renders the button or\n * changes the page the sign-in should return to, and the cookie is\n * re-read when the tab regains focus so a sign-in or sign-out in another\n * tab is reflected without a reload.\n */\nconst SIGN_IN_HREF = 'https://openrouter.ai/sign-in';\n// Mirrors navbar.primary.label in docs.json.\nconst SIGN_IN_LABEL = 'Sign In';\nconst HOME_HREF = 'https://openrouter.ai/workspaces';\nconst HOME_LABEL = 'Home';\n\nfunction isSignedIn() {\n  return document.cookie.split('; ').some((cookie) =\u003e {\n    const [name, value] = cookie.split('=');\n    return name?.startsWith('__client_uat') \u0026\u0026 value !== undefined \u0026\u0026 value !== '' \u0026\u0026 value !== '0';\n  });\n}\n\nfunction signInHref() {\n  const url = new URL(SIGN_IN_HREF);\n  url.searchParams.set('redirect_url', window.location.href);\n  return url.href;\n}\n\nfunction setLabel(link, text) {\n  const label = [...link.querySelectorAll('*')].findLast(\n    (el) =\u003e !(el instanceof SVGElement) \u0026\u0026 el.childElementCount === 0,\n  );\n  (label ?? link).textContent = text;\n}\n\nfunction applyCta() {\n  const cta = document.querySelector('#topbar-cta-button');\n  if (!cta) {\n    return;\n  }\n  const link = cta.matches('a') ? cta : cta.querySelector('a');\n  if (!link) {\n    return;\n  }\n  const signedIn = isSignedIn();\n  const href = signedIn ? HOME_HREF : signInHref();\n  if (link.getAttribute('href') === href) {\n    return;\n  }\n  link.setAttribute('href', href);\n  setLabel(link, signedIn ? HOME_LABEL : SIGN_IN_LABEL);\n}\n\nfunction initAuthCta() {\n  applyCta();\n  new MutationObserver(applyCta).observe(document.body, {\n    childList: true,\n    subtree: true,\n  });\n  window.addEventListener('focus', applyCta);\n  document.addEventListener('visibilitychange', applyCta);\n}\n\ninitAuthCta();\n"])</script><script>self.__next_f.push([1,"56:[\"$\",\"$L5d\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"6a58359481eda2c0540fae86\",\"filePath\":\"anchor-scroll-fix.js\",\"subdomain\":\"openrouter-d02e98a0\",\"__v\":0,\"content\":\"$5e\"},{\"_id\":\"6a98b868be6327d3d8e10c83\",\"filePath\":\"auth-cta.js\",\"subdomain\":\"openrouter-d02e98a0\",\"__v\":0,\"content\":\"$5f\"}]}]\n62:T15a67,"])</script><script>self.__next_f.pus